# Przykładowe zmienne środowiskowe frontendu (skopiuj do .env.local).
# Plik .env.local jest gitignore'owany — sekrety trzymają się poza repo.

# Sekret podpisu sesji NextAuth. BEZ niego logowanie (także do /admin/login)
# działa nieprzewidywalnie, a middleware nie zweryfikuje sesji.
# Wygeneruj:  openssl rand -base64 32
# MUSI być tą samą wartością co NEXTAUTH_SECRET na backendzie (docker-compose / Cloud Run),
# inaczej AdminAuthFilter nie odszyfruje ciasteczka sesji administratora.
NEXTAUTH_SECRET=

# Opcjonalnie: publiczny adres API (domyślnie dev = http://localhost:8080,
# produkcja = /api/backend proxy). Zwykle NIE trzeba ustawiać.
# NEXT_PUBLIC_API_URL=

# Pełny adres aplikacji (potrzebny m.in. NextAuth przy deployu).
# NEXTAUTH_URL=http://localhost:3001
